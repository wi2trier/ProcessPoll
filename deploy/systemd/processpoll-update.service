[Unit]
Description=ProcessPoll: pull new images and restart if changed
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=processpoll
SupplementaryGroups=docker
WorkingDirectory=/opt/processpoll/deploy
ExecStart=/opt/processpoll/deploy/pull-and-restart.sh --quiet

SuccessExitStatus=3
TimeoutStartSec=20min
Nice=10
