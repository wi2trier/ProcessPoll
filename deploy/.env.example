IMAGE_PREFIX=REGISTRY_HOST/OWNER/process-trace-polling

IMAGE_TAG=stable

SITE_ADDRESS=poll.example.org

HTTP_PORT=80
HTTPS_PORT=443

CADDY_CONF_DIR=./caddy.d

PROCESSPOLL_PUBLIC_URL=https://poll.example.org

PROCESSPOLL_ALLOWED_ORIGINS=https://poll.example.org

PROCESSPOLL_SESSION_CREATE_PER_HOUR=30

PROCESSPOLL_COMPUTE_PROCESSES=2

PROCESSPOLL_DEMO_MODE=false

POSTGRES_USER=processpoll
POSTGRES_DB=processpoll

POSTGRES_PASSWORD=

BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=14

BACKUP_HOST_DIR=./backups

BACKUP_UID=0
BACKUP_GID=0

REGISTRY_USER=
REGISTRY_TOKEN_FILE=/etc/processpoll/registry-token

HEALTHCHECK_URL=

HEALTH_TIMEOUT=180
